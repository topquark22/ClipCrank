#!/usr/bin/env bash
set -eu

progname="${0##*/}"

preserve_metadata=false
clear_metadata=false
metadata_args=()
positional_args=()
force=false
reencode=false
add_audio=false
extract_audio=false
remove_audio=false
remux=false
show_info=false

fps=
cfr=false
clip_start=
clip_end=
clip_start_seconds=
clip_duration=
frame_time=
frame_seconds=
frame_interval=
frame_interval_seconds=
frame_count=
frame_filename_hours=false
frame_filename_millis=false
jpeg_quality=90
jpeg_quality_set=false
show_metadata=false

usage() {
    cat <<EOF
Usage: $progname [OPTIONS] INPUT [OUTPUT]

Perform a selected video operation using ffmpeg.

Arguments:
  INPUT                    Path to input video file
  OUTPUT                   Optional output path or multi-frame output base

Operations:
  --reencode                Re-encode input as standardized H.264/AAC MP4
  --add-audio               Add or replace audio: VIDEO|IMAGE AUDIO [OUTPUT]
  --extract-audio           Extract audio as MP3
  --remove-audio            Remove audio: INPUT OUTPUT
  --remux                   Change container without re-encoding: INPUT OUTPUT
  --info                    Display technical media information and exit
  --show-metadata           Display input metadata and exit
  --frame TIME              Capture JPEG frame(s) starting at [[h:]m:]s[.ms]

Options:
  -f, --force              Overwrite existing output files
  --metadata KEY=VALUE     Set an MP4 metadata field; may be repeated
  --title TEXT             Set title metadata
  --artist TEXT            Set artist metadata
  --album TEXT             Set album metadata
  --date TEXT              Set date metadata
  --comment TEXT           Set comment metadata
  --preserve-metadata      Preserve input global metadata before applying edits
  --clear-metadata         Clear input global metadata before applying edits
  --start TIME             Start output at [[h:]m:]s[.ms]; defaults to input start
  --end TIME               End output at [[h:]m:]s[.ms]; defaults to input end
  --interval TIME          Interval between frames; requires --frame and --count
  --count N                Number of frames to capture; requires --frame and --interval
  --jpeg-quality N         JPEG quality from 1 to 100; default 90
  --fps N                  Convert output video to frame rate N
  --cfr                    Force constant frame rate output; cannot be used with --fps
  -h, --help               Show this help text

Examples:
  $progname --reencode old-video.avi
  $progname --reencode -f input.mov output.mp4
  $progname --add-audio input.mp4 soundtrack.wav output.mp4
  $progname --add-audio image.jpg soundtrack.wav output.mp4
  $progname --extract-audio input.mp4 output.mp3
  $progname --remove-audio input.mp4 silent.mp4
  $progname --remux input.mkv output.mp4
  $progname --info input.mov
  $progname --show-metadata input.mov
  $progname --reencode --start 12.500 --end 2:05 input.mov clip.mp4
  $progname --frame 1:23.500 input.mp4
  $progname --frame 10 --interval 5 --count 4 input.mp4
  $progname --force --frame 1:00 --interval 10 --count 3 input.mp4 shots.jpg
EOF
}

error() {
    printf '%s: %s\n' "$progname" "$*" >&2
}

info() {
    printf '%s: %s\n' "$progname" "$*"
}

have_command() {
    command -v "$1" >/dev/null 2>&1
}

probe_value() {
    input=$1
    entries=$2
    selector=${3:-}

    selector_args=()
    if [ -n "$selector" ]; then
        selector_args=( -select_streams "$selector" )
    fi

    ffprobe \
        -v error \
        "${selector_args[@]}" \
        -show_entries "$entries" \
        -of default=noprint_wrappers=1:nokey=1 \
        "$input" 2>/dev/null |
    tr -d '\r' |
    head -n 1
}

format_duration() {
    value=$1

    awk -v t="$value" 'BEGIN {
        if (t == "" || t == "N/A") exit
        h=int(t/3600); t-=h*3600
        m=int(t/60); s=t-m*60
        printf "%02d:%02d:%06.3f", h, m, s
    }'
}

format_bitrate() {
    value=$1

    if [ -n "$value" ] && [ "$value" != "N/A" ]; then
        awk -v b="$value" 'BEGIN { printf "%.0f kb/s", b/1000 }'
    fi
}

format_frame_rate() {
    value=$1

    if [ -n "$value" ] && [ "$value" != "N/A" ] && [ "$value" != "0/0" ]; then
        awk -F/ '{
            if (NF == 2 && $2 != 0) printf "%.3f fps", $1/$2
            else printf "%s fps", $1
        }' <<< "$value" |
        sed 's/\.000 fps$/ fps/'
    fi
}

show_media_info() {
    input=$1

    format_name=$(probe_value "$input" format=format_name)
    format_long_name=$(probe_value "$input" format=format_long_name)
    duration=$(format_duration "$(probe_value "$input" format=duration)")
    overall_bitrate=$(format_bitrate "$(probe_value "$input" format=bit_rate)")

    video_codec=$(probe_value "$input" stream=codec_name v:0)
    video_width=$(probe_value "$input" stream=width v:0)
    video_height=$(probe_value "$input" stream=height v:0)
    video_rate=$(format_frame_rate "$(probe_value "$input" stream=r_frame_rate v:0)")
    video_pixel_format=$(probe_value "$input" stream=pix_fmt v:0)
    video_bitrate=$(format_bitrate "$(probe_value "$input" stream=bit_rate v:0)")

    audio_codec=$(probe_value "$input" stream=codec_name a:0)
    audio_sample_rate=$(probe_value "$input" stream=sample_rate a:0)
    audio_channels=$(probe_value "$input" stream=channels a:0)
    audio_bitrate=$(format_bitrate "$(probe_value "$input" stream=bit_rate a:0)")

    printf 'File: %s\n\n' "$input"
    printf 'Container:\n'
    if [ -n "$format_long_name" ]; then
        if [ -n "$format_name" ]; then
            printf '  Format:      %s (%s)\n' "$format_long_name" "$format_name"
        else
            printf '  Format:      %s\n' "$format_long_name"
        fi
    elif [ -n "$format_name" ]; then
        printf '  Format:      %s\n' "$format_name"
    fi
    [ -z "$duration" ] || printf '  Duration:    %s\n' "$duration"
    [ -z "$overall_bitrate" ] || printf '  Bitrate:     %s\n' "$overall_bitrate"

    if [ -n "$video_codec" ]; then
        printf '\nVideo:\n'
        printf '  Codec:       %s\n' "$video_codec"
        if [ -n "$video_width" ] && [ -n "$video_height" ]; then
            printf '  Resolution:  %sx%s\n' "$video_width" "$video_height"
        fi
        [ -z "$video_rate" ] || printf '  Frame rate:  %s\n' "$video_rate"
        [ -z "$video_pixel_format" ] || printf '  Pixel format: %s\n' "$video_pixel_format"
        [ -z "$video_bitrate" ] || printf '  Bitrate:     %s\n' "$video_bitrate"
    fi

    printf '\nAudio:\n'
    if [ -n "$audio_codec" ]; then
        printf '  Codec:       %s\n' "$audio_codec"
        [ -z "$audio_sample_rate" ] || printf '  Sample rate: %s Hz\n' "$audio_sample_rate"
        [ -z "$audio_channels" ] || printf '  Channels:    %s\n' "$audio_channels"
        [ -z "$audio_bitrate" ] || printf '  Bitrate:     %s\n' "$audio_bitrate"
    else
        printf '  None\n'
    fi
}

classify_visual_input() {
    input=$1

    if ! have_command ffprobe; then
        error "ffprobe is not installed or not on PATH"
        exit 127
    fi

    kind=$(
        ffprobe \
            -v error \
            -select_streams v:0 \
            -show_frames \
            -show_entries frame=media_type \
            -of csv=p=0 \
            "$input" 2>/dev/null |
        tr -d '\r' |
        awk '
            $0 == "video" {
                count++
                if (count >= 2) {
                    print "video"
                    exit
                }
            }
            END {
                if (count == 1) {
                    print "image"
                }
            }
        '
    )

    case "$kind" in
        image|video) printf '%s\n' "$kind" ;;
        *)
            error "input is not a supported video or still image: $input"
            exit 1
            ;;
    esac
}

derive_video_output_path() {
    input=$1

    case "$input" in
        *.*) printf '%s\n' "${input%.*}.mp4" ;;
        *)   printf '%s\n' "${input}.mp4" ;;
    esac
}

derive_audio_output_path() {
    input=$1

    case "$input" in
        *.*) printf '%s\n' "${input%.*}.mp3" ;;
        *)   printf '%s\n' "${input}.mp3" ;;
    esac
}

derive_frame_output_path() {
    input=$1
    timestamp=$(seconds_to_filename_timestamp "$frame_seconds" "$frame_filename_hours" "$frame_filename_millis")

    case "$input" in
        *.*) printf '%s\n' "${input%.*}-${timestamp}.jpg" ;;
        *)   printf '%s\n' "${input}-${timestamp}.jpg" ;;
    esac
}

add_metadata() {
    metadata_args+=( -metadata "$1=$2" )
}

add_metadata_pair() {
    case "$1" in
        *=*) metadata_args+=( -metadata "$1" ) ;;
        *)
            error "metadata must be in KEY=VALUE form: $1"
            exit 2
            ;;
    esac
}

require_option_value() {
    if [ "$2" -lt 2 ]; then
        error "$1 requires a value"
        exit 2
    fi
}

reject_equals_option() {
    error "use '$1 VALUE', not '$1=VALUE'"
    exit 2
}

set_metadata_option() {
    case "$1" in
        --title)   add_metadata title "$2" ;;
        --artist)  add_metadata artist "$2" ;;
        --album)   add_metadata album "$2" ;;
        --date)    add_metadata date "$2" ;;
        --comment) add_metadata comment "$2" ;;
        *)
            error "internal parser error for metadata option: $1"
            exit 2
            ;;
    esac
}

validate_positive_number() {
    value=$1
    name=$2

    case "$value" in
        ''|*[!0-9.]*|*.*.*)
            error "$name must be a positive number"
            exit 2
            ;;
    esac

    awk "BEGIN { exit !($value > 0) }" || {
        error "$name must be greater than zero"
        exit 2
    }
}

validate_positive_integer() {
    value=$1
    name=$2

    case "$value" in
        ''|*[!0-9]*)
            error "$name must be a positive integer"
            exit 2
            ;;
    esac

    if [ "$value" -lt 1 ]; then
        error "$name must be a positive integer"
        exit 2
    fi
}

validate_jpeg_quality() {
    case "$jpeg_quality" in
        ''|*[!0-9]*)
            error "jpeg-quality must be an integer from 1 to 100"
            exit 2
            ;;
    esac

    if [ "$jpeg_quality" -lt 1 ] || [ "$jpeg_quality" -gt 100 ]; then
        error "jpeg-quality must be an integer from 1 to 100"
        exit 2
    fi
}

validate_timestamp() {
    value=$1
    name=$2

    [[ "$value" =~ ^[0-9]+(\.[0-9]{1,3})?$ ]] && return
    [[ "$value" =~ ^[0-9]+:([0-5]?[0-9])(\.[0-9]{1,3})?$ ]] && return
    [[ "$value" =~ ^[0-9]+:([0-5]?[0-9]):([0-5]?[0-9])(\.[0-9]{1,3})?$ ]] && return

    error "$name must be in [[h:]m:]s[.ms] form"
    exit 2
}

timestamp_to_seconds() {
    awk -F: '
        NF == 1 { printf "%.3f\n", $1; next }
        NF == 2 { printf "%.3f\n", ($1 * 60) + $2; next }
        NF == 3 { printf "%.3f\n", ($1 * 3600) + ($2 * 60) + $3 }
    ' <<< "$1"
}

seconds_to_filename_timestamp() {
    seconds=$1
    include_hours=$2
    include_millis=$3

    awk -v t="$seconds" -v hours="$include_hours" -v millis="$include_millis" 'BEGIN {
        if (hours == "true") {
            h=int(t/3600); t-=h*3600; m=int(t/60); s=t-m*60;
            if (millis == "true") printf "%02d-%02d-%06.3f",h,m,s;
            else printf "%02d-%02d-%02d",h,m,int(s);
        } else {
            m=int(t/60); s=t-m*60;
            if (millis == "true") printf "%02d-%06.3f",m,s;
            else printf "%02d-%02d",m,int(s);
        }
    }'
}

validate_clip() {
    if [ -n "$clip_start" ]; then
        validate_timestamp "$clip_start" start
        clip_start_seconds=$(timestamp_to_seconds "$clip_start")
    fi

    if [ -n "$clip_end" ]; then
        validate_timestamp "$clip_end" end
    fi

    [ -z "$clip_end" ] && return
    end_seconds=$(timestamp_to_seconds "$clip_end")

    if [ -n "$clip_start" ]; then
        awk "BEGIN {exit !($end_seconds > $clip_start_seconds)}" || {
            error "--end must be later than --start"
            exit 2
        }
        clip_duration=$(awk "BEGIN {printf \"%.3f\",$end_seconds-$clip_start_seconds}")
    else
        awk "BEGIN {exit !($end_seconds > 0)}" || {
            error "--end must be later than the start of the input"
            exit 2
        }
        clip_duration=$end_seconds
    fi
}

validate_frame_modes() {
    if [ -z "$frame_time" ]; then
        if [ -n "$frame_interval" ]; then
            error "--interval requires --frame"
            exit 2
        fi
        if [ -n "$frame_count" ]; then
            error "--count requires --frame"
            exit 2
        fi
        if [ "$jpeg_quality_set" = true ]; then
            error "--jpeg-quality requires --frame"
            exit 2
        fi
        return
    fi

    validate_timestamp "$frame_time" frame
    frame_seconds=$(timestamp_to_seconds "$frame_time")

    case "$frame_time" in
        *:*:*) frame_filename_hours=true ;;
    esac
    case "$frame_time" in
        *.*) frame_filename_millis=true ;;
    esac

    if [ -n "$frame_interval" ] || [ -n "$frame_count" ]; then
        if [ -z "$frame_interval" ]; then
            error "--count requires --interval"
            exit 2
        fi
        if [ -z "$frame_count" ]; then
            error "--interval requires --count"
            exit 2
        fi

        validate_timestamp "$frame_interval" interval
        frame_interval_seconds=$(timestamp_to_seconds "$frame_interval")
        awk "BEGIN {exit !($frame_interval_seconds > 0)}" || {
            error "interval must be greater than zero"
            exit 2
        }
        validate_positive_integer "$frame_count" count

        last_frame_seconds=$(awk "BEGIN {printf \"%.3f\", $frame_seconds + (($frame_count - 1) * $frame_interval_seconds)}")
        if awk "BEGIN {exit !($last_frame_seconds >= 3600)}"; then
            frame_filename_hours=true
        fi

        case "$frame_interval" in
            *.*) frame_filename_millis=true ;;
        esac
    fi

    validate_jpeg_quality

    if [ -n "$clip_start" ] || [ -n "$clip_end" ]; then
        error "frame capture cannot be used with --start or --end"
        exit 2
    fi

    if [ -n "$fps" ] || [ "$cfr" = true ]; then
        error "frame capture cannot be used with --fps or --cfr"
        exit 2
    fi

    if [ "$preserve_metadata" = true ] || [ "$clear_metadata" = true ] || [ "${#metadata_args[@]}" -gt 0 ]; then
        error "frame capture cannot be used with metadata options"
        exit 2
    fi
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -h|--help)
                usage
                exit 0
                ;;
            -f|--force)
                force=true
                shift
                ;;
            --reencode)
                reencode=true
                shift
                ;;
            --add-audio)
                add_audio=true
                shift
                ;;
            --extract-audio)
                extract_audio=true
                shift
                ;;
            --remove-audio)
                remove_audio=true
                shift
                ;;
            --remux)
                remux=true
                shift
                ;;
            --info)
                show_info=true
                shift
                ;;
            --*=*)
                reject_equals_option "${1%%=*}"
                ;;
            --metadata)
                require_option_value "$1" "$#"
                add_metadata_pair "$2"
                shift 2
                ;;
            --title|--artist|--album|--date|--comment)
                require_option_value "$1" "$#"
                set_metadata_option "$1" "$2"
                shift 2
                ;;
            --preserve-metadata)
                preserve_metadata=true
                shift
                ;;
            --clear-metadata)
                clear_metadata=true
                shift
                ;;
            --show-metadata)
                show_metadata=true
                shift
                ;;
            --start)
                require_option_value "$1" "$#"
                clip_start=$2
                shift 2
                ;;
            --end)
                require_option_value "$1" "$#"
                clip_end=$2
                shift 2
                ;;
            --frame)
                require_option_value "$1" "$#"
                frame_time=$2
                shift 2
                ;;
            --interval)
                require_option_value "$1" "$#"
                frame_interval=$2
                shift 2
                ;;
            --count)
                require_option_value "$1" "$#"
                frame_count=$2
                shift 2
                ;;
            --jpeg-quality)
                require_option_value "$1" "$#"
                jpeg_quality=$2
                jpeg_quality_set=true
                shift 2
                ;;
            --fps)
                require_option_value "$1" "$#"
                fps=$2
                shift 2
                ;;
            --cfr)
                cfr=true
                shift
                ;;
            --)
                shift
                while [ "$#" -gt 0 ]; do
                    positional_args+=( "$1" )
                    shift
                done
                ;;
            --*)
                error "unknown option: $1"
                usage >&2
                exit 2
                ;;
            *)
                positional_args+=( "$1" )
                shift
                ;;
        esac
    done

    if [ "$preserve_metadata" = true ] && [ "$clear_metadata" = true ]; then
        error "--preserve-metadata and --clear-metadata cannot be used together"
        exit 2
    fi

    if [ -n "$fps" ] && [ "$cfr" = true ]; then
        error "--fps and --cfr cannot be used together"
        exit 2
    fi

    if [ -n "$fps" ]; then
        validate_positive_number "$fps" fps
    fi

    validate_clip
    validate_frame_modes
}

have_encoder() {
    ffmpeg -hide_banner -encoders 2>/dev/null | awk '{print $2}' | grep -Fx "$1" >/dev/null 2>&1
}

select_video_encoder() {
    for encoder in \
        libx264 \
        libopenh264 \
        h264_nvenc \
        h264_qsv \
        h264_amf \
        h264_mf \
        h264_d3d12va \
        h264_vulkan \
        h264_videotoolbox
    do
        if have_encoder "$encoder"; then
            printf '%s\n' "$encoder"
            return 0
        fi
    done

    return 1
}

select_mp3_encoder() {
    for encoder in \
        libmp3lame \
        libshine \
        mp3_mf
    do
        if have_encoder "$encoder"; then
            printf '%s\n' "$encoder"
            return 0
        fi
    done

    return 1
}

have_aac_encoder() {
    have_encoder aac
}

video_encoder_args() {
    case "$1" in
        libx264)
            printf '%s\n' -c:v libx264 -preset medium -crf 23
            ;;
        libopenh264)
            printf '%s\n' -c:v libopenh264 -b:v 5000k
            ;;
        h264_nvenc|h264_qsv|h264_amf|h264_mf|h264_d3d12va|h264_vulkan|h264_videotoolbox)
            printf '%s\n' -c:v "$1" -b:v 5000k
            ;;
        *)
            error "unsupported encoder selection: $1"
            return 1
            ;;
    esac
}

build_video_filters() {
    filters=( "scale=trunc(iw/2)*2:trunc(ih/2)*2" )

    if [ -n "$fps" ]; then
        filters+=( "fps=$fps" )
    fi

    IFS=,
    printf '%s\n' "${filters[*]}"
}

jpeg_qscale() {
    awk "BEGIN { printf \"%d\", 31 - (($jpeg_quality - 1) * 29 / 99) }"
}

capture_frame() {
    input=$1
    timestamp_seconds=$2
    tmp_output=$3

    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -ss "$timestamp_seconds" \
        -i "$input" \
        -map 0:v:0 \
        -frames:v 1 \
        -q:v "$(jpeg_qscale)" \
        -f image2 \
        "$tmp_output"
}

run_ffmpeg() {
    encoder=$1
    input=$2
    tmp_output=$3

    encoder_args=()
    while IFS= read -r arg; do
        encoder_args+=( "$arg" )
    done <<EOF
$(video_encoder_args "$encoder")
EOF

    metadata_mode_args=()
    if [ "$clear_metadata" = true ]; then
        metadata_mode_args=( -map_metadata -1 )
    elif [ "$preserve_metadata" = true ]; then
        metadata_mode_args=( -map_metadata 0 )
    fi

    cfr_args=()
    if [ "$cfr" = true ]; then
        cfr_args=( -vsync cfr )
    fi

    seek_args=()
    if [ -n "$clip_start_seconds" ]; then
        seek_args=( -ss "$clip_start_seconds" )
    fi

    duration_args=()
    if [ -n "$clip_duration" ]; then
        duration_args=( -t "$clip_duration" )
    fi

    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -fflags +genpts \
        "${seek_args[@]}" \
        -i "$input" \
        "${duration_args[@]}" \
        -map 0:v:0 \
        -map 0:a? \
        -dn \
        -sn \
        "${cfr_args[@]}" \
        "${metadata_mode_args[@]}" \
        "${metadata_args[@]}" \
        "${encoder_args[@]}" \
        -pix_fmt yuv420p \
        -vf "$(build_video_filters)" \
        -movflags +faststart \
        -c:a aac \
        -b:a 192k \
        -f mp4 \
        "$tmp_output"
}

run_add_audio() {
    encoder=$1
    media_input=$2
    audio_input=$3
    tmp_output=$4
    input_is_image=$5

    encoder_args=()
    while IFS= read -r arg; do
        encoder_args+=( "$arg" )
    done <<EOF
$(video_encoder_args "$encoder")
EOF

    metadata_mode_args=()
    if [ "$clear_metadata" = true ]; then
        metadata_mode_args=( -map_metadata -1 )
    elif [ "$preserve_metadata" = true ]; then
        metadata_mode_args=( -map_metadata 0 )
    fi

    cfr_args=()
    if [ "$cfr" = true ]; then
        cfr_args=( -vsync cfr )
    fi

    first_input_args=()
    shortest_args=()
    if [ "$input_is_image" = true ]; then
        first_input_args=( -stream_loop -1 )
        shortest_args=( -shortest )
    else
        first_input_args=( -fflags +genpts )
    fi

    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        "${first_input_args[@]}" \
        -i "$media_input" \
        -i "$audio_input" \
        -map 0:v:0 \
        -map 1:a:0 \
        -dn \
        -sn \
        "${cfr_args[@]}" \
        "${metadata_mode_args[@]}" \
        "${metadata_args[@]}" \
        "${encoder_args[@]}" \
        -pix_fmt yuv420p \
        -vf "$(build_video_filters)" \
        -movflags +faststart \
        -c:a aac \
        -b:a 192k \
        "${shortest_args[@]}" \
        -f mp4 \
        "$tmp_output"
}

run_extract_audio() {
    encoder=$1
    input=$2
    tmp_output=$3

    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -i "$input" \
        -map 0:a:0 \
        -vn \
        -dn \
        -sn \
        -c:a "$encoder" \
        -b:a 192k \
        -f mp3 \
        "$tmp_output"
}

run_remove_audio() {
    encoder=$1
    input=$2
    tmp_output=$3

    encoder_args=()
    while IFS= read -r arg; do
        encoder_args+=( "$arg" )
    done <<EOF
$(video_encoder_args "$encoder")
EOF

    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -fflags +genpts \
        -i "$input" \
        -map 0:v:0 \
        -an \
        -dn \
        -sn \
        "${encoder_args[@]}" \
        -pix_fmt yuv420p \
        -vf "$(build_video_filters)" \
        -movflags +faststart \
        -f mp4 \
        "$tmp_output"
}

run_remux() {
    input=$1
    tmp_output=$2

    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -i "$input" \
        -map 0 \
        -c copy \
        "$tmp_output"
}

multi_frame_output_base() {
    input=$1
    requested=${2:-}

    if [ -n "$requested" ]; then
        case "$requested" in
            *.jpg)  printf '%s\n' "${requested%.jpg}" ;;
            *.jpeg) printf '%s\n' "${requested%.jpeg}" ;;
            *)      printf '%s\n' "$requested" ;;
        esac
    else
        case "$input" in
            *.*) printf '%s\n' "${input%.*}" ;;
            *)   printf '%s\n' "$input" ;;
        esac
    fi
}

parse_args "$@"

operation_count=0
[ "$reencode" = false ] || operation_count=$((operation_count + 1))
[ "$add_audio" = false ] || operation_count=$((operation_count + 1))
[ "$extract_audio" = false ] || operation_count=$((operation_count + 1))
[ "$remove_audio" = false ] || operation_count=$((operation_count + 1))
[ "$remux" = false ] || operation_count=$((operation_count + 1))
[ "$show_info" = false ] || operation_count=$((operation_count + 1))
[ "$show_metadata" = false ] || operation_count=$((operation_count + 1))
[ -z "$frame_time" ] || operation_count=$((operation_count + 1))

if [ "$operation_count" -eq 0 ]; then
    usage >&2
    exit 2
fi

if [ "$operation_count" -gt 1 ]; then
    error "only one operation may be specified"
    exit 2
fi

if [ "$add_audio" = true ]; then
    if [ "${#positional_args[@]}" -lt 2 ] || [ "${#positional_args[@]}" -gt 3 ]; then
        usage >&2
        exit 2
    fi
elif [ "$remove_audio" = true ] || [ "$remux" = true ]; then
    if [ "${#positional_args[@]}" -ne 2 ]; then
        usage >&2
        exit 2
    fi
else
    if [ "${#positional_args[@]}" -lt 1 ] || [ "${#positional_args[@]}" -gt 2 ]; then
        usage >&2
        exit 2
    fi
fi

input=${positional_args[0]}
requested_output=${positional_args[1]:-}

if [ "$add_audio" = true ]; then
    audio_input=${positional_args[1]}
    requested_output=${positional_args[2]:-}
fi

if [ "$show_info" = true ]; then
    if [ -n "$requested_output" ]; then
        error "--info does not accept an output file"
        exit 2
    fi

    if [ "$force" = true ] || [ "$preserve_metadata" = true ] || [ "$clear_metadata" = true ] || [ "${#metadata_args[@]}" -gt 0 ] || [ -n "$clip_start" ] || [ -n "$clip_end" ] || [ -n "$fps" ] || [ "$cfr" = true ]; then
        error "--info cannot be combined with output options"
        exit 2
    fi

    if ! have_command ffprobe; then
        error "ffprobe is not installed or not on PATH"
        exit 127
    fi

    if [ ! -e "$input" ]; then
        error "input file not found: $input"
        exit 1
    fi

    if [ ! -f "$input" ]; then
        error "input path is not a regular file: $input"
        exit 1
    fi

    if [ ! -r "$input" ]; then
        error "input file is not readable: $input"
        exit 1
    fi

    show_media_info "$input"
    exit 0
fi

if [ "$show_metadata" = true ]; then
    if [ -n "$requested_output" ]; then
        error "--show-metadata does not accept an output file"
        exit 2
    fi

    if [ "$force" = true ] || [ "$preserve_metadata" = true ] || [ "$clear_metadata" = true ] || [ "${#metadata_args[@]}" -gt 0 ] || [ -n "$clip_start" ] || [ -n "$clip_end" ] || [ -n "$fps" ] || [ "$cfr" = true ]; then
        error "--show-metadata cannot be combined with output options"
        exit 2
    fi

    if ! have_command ffprobe; then
        error "ffprobe is not installed or not on PATH"
        exit 127
    fi

    if [ ! -e "$input" ]; then
        error "input file not found: $input"
        exit 1
    fi

    if [ ! -f "$input" ]; then
        error "input path is not a regular file: $input"
        exit 1
    fi

    if [ ! -r "$input" ]; then
        error "input file is not readable: $input"
        exit 1
    fi

    ffprobe \
        -v error \
        -show_entries format_tags:stream_tags \
        -of default \
        "$input"
    exit 0
fi

if ! have_command ffmpeg; then
    error "ffmpeg is not installed or not on PATH"
    exit 127
fi

if [ ! -e "$input" ]; then
    error "input file not found: $input"
    exit 1
fi

if [ ! -f "$input" ]; then
    error "input path is not a regular file: $input"
    exit 1
fi

if [ ! -r "$input" ]; then
    error "input file is not readable: $input"
    exit 1
fi

if [ "$remux" = true ]; then
    if [ -n "$clip_start" ] || [ -n "$clip_end" ] || [ -n "$fps" ] || [ "$cfr" = true ] || [ "$preserve_metadata" = true ] || [ "$clear_metadata" = true ] || [ "${#metadata_args[@]}" -gt 0 ]; then
        error "--remux cannot be combined with video or metadata options"
        exit 2
    fi

    output=$requested_output

    case "$output" in
        *.*) ;;
        *)
            error "remux output must include a file extension"
            exit 2
            ;;
    esac

    if [ "$input" = "$output" ]; then
        error "input and output paths must be different"
        exit 1
    fi

    if [ "$force" = false ] && [ -e "$output" ]; then
        error "output file already exists: $output"
        exit 1
    fi

    tmp_output="${output%.*}.part.${output##*.}"

    info "remuxing without re-encoding"

    cleanup() {
        [ ! -e "$tmp_output" ] || rm -f "$tmp_output"
    }

    trap cleanup EXIT INT TERM HUP

    if ! run_remux "$input" "$tmp_output"; then
        error "remux failed"
        exit 1
    fi

    mv -f -- "$tmp_output" "$output"
    trap - EXIT INT TERM HUP
    printf 'created: %s\n' "$output"
    exit 0
fi

if [ "$extract_audio" = true ]; then
    if [ -n "$clip_start" ] || [ -n "$clip_end" ] || [ -n "$fps" ] || [ "$cfr" = true ] || [ "$preserve_metadata" = true ] || [ "$clear_metadata" = true ] || [ "${#metadata_args[@]}" -gt 0 ]; then
        error "--extract-audio cannot be combined with video or metadata options"
        exit 2
    fi

    output=${requested_output:-$(derive_audio_output_path "$input")}

    case "$output" in
        *.mp3) ;;
        *)
            error "audio output must use .mp3"
            exit 2
            ;;
    esac

    if [ "$input" = "$output" ]; then
        error "input and output paths must be different"
        exit 1
    fi

    if [ "$force" = false ] && [ -e "$output" ]; then
        error "output file already exists: $output"
        exit 1
    fi

    if ! audio_encoder=$(select_mp3_encoder); then
        error "no supported MP3 encoder found in ffmpeg"
        error "tried: libmp3lame, libshine, mp3_mf"
        exit 1
    fi

    tmp_output="${output%.mp3}.part.mp3"

    info "using audio encoder: $audio_encoder"

    cleanup() {
        [ ! -e "$tmp_output" ] || rm -f "$tmp_output"
    }

    trap cleanup EXIT INT TERM HUP

    if ! run_extract_audio "$audio_encoder" "$input" "$tmp_output"; then
        error "audio extraction failed"
        exit 1
    fi

    mv -f -- "$tmp_output" "$output"
    trap - EXIT INT TERM HUP
    printf 'created: %s\n' "$output"
    exit 0
fi

if [ "$remove_audio" = true ]; then
    if [ -n "$clip_start" ] || [ -n "$clip_end" ] || [ -n "$fps" ] || [ "$cfr" = true ] || [ "$preserve_metadata" = true ] || [ "$clear_metadata" = true ] || [ "${#metadata_args[@]}" -gt 0 ]; then
        error "--remove-audio cannot be combined with video or metadata options"
        exit 2
    fi

    output=$requested_output

    case "$output" in
        *.mp4) ;;
        *)
            error "video output must use .mp4"
            exit 2
            ;;
    esac

    if [ "$input" = "$output" ]; then
        error "input and output paths must be different"
        exit 1
    fi

    if [ "$force" = false ] && [ -e "$output" ]; then
        error "output file already exists: $output"
        exit 1
    fi

    tmp_output="${output%.mp4}.part.mp4"

    if ! video_encoder=$(select_video_encoder); then
        error "no supported H.264 encoder found in ffmpeg"
        error "tried: libx264, libopenh264, h264_nvenc, h264_qsv, h264_amf, h264_mf, h264_d3d12va, h264_vulkan, h264_videotoolbox"
        exit 1
    fi

    info "using video encoder: $video_encoder"

    cleanup() {
        [ ! -e "$tmp_output" ] || rm -f "$tmp_output"
    }

    trap cleanup EXIT INT TERM HUP

    if ! run_remove_audio "$video_encoder" "$input" "$tmp_output"; then
        error "audio removal failed"
        exit 1
    fi

    mv -f -- "$tmp_output" "$output"
    trap - EXIT INT TERM HUP
    printf 'created: %s\n' "$output"
    exit 0
fi

if [ "$add_audio" = true ]; then
    input_kind=$(classify_visual_input "$input")
    input_is_image=false
    [ "$input_kind" != image ] || input_is_image=true

    if [ ! -e "$audio_input" ]; then
        error "audio file not found: $audio_input"
        exit 1
    fi

    if [ ! -f "$audio_input" ]; then
        error "audio path is not a regular file: $audio_input"
        exit 1
    fi

    if [ ! -r "$audio_input" ]; then
        error "audio file is not readable: $audio_input"
        exit 1
    fi

    if [ -n "$clip_start" ] || [ -n "$clip_end" ]; then
        error "--add-audio cannot be used with --start or --end"
        exit 2
    fi

    if [ "$input_is_image" = true ] && [ "$preserve_metadata" = true ]; then
        error "--add-audio with a still image cannot be used with --preserve-metadata"
        exit 2
    fi

    if [ "$input_is_image" = true ]; then
        output=${requested_output:-$(derive_video_output_path "$audio_input")}
    else
        output=${requested_output:-$(derive_video_output_path "$input")}
    fi

    if [ "$input" = "$output" ] || [ "$audio_input" = "$output" ]; then
        error "input and output paths must be different"
        exit 1
    fi

    if [ "$force" = false ] && [ -e "$output" ]; then
        error "output file already exists: $output"
        exit 1
    fi

    if ! have_aac_encoder; then
        error "AAC encoder not found in ffmpeg"
        exit 1
    fi

    case "$output" in
        *.mp4) tmp_output="${output%.mp4}.part.mp4" ;;
        *)     tmp_output="${output}.part.mp4" ;;
    esac

    if ! video_encoder=$(select_video_encoder); then
        error "no supported H.264 encoder found in ffmpeg"
        error "tried: libx264, libopenh264, h264_nvenc, h264_qsv, h264_amf, h264_mf, h264_d3d12va, h264_vulkan, h264_videotoolbox"
        exit 1
    fi

    info "using video encoder: $video_encoder"
    info "adding audio: $audio_input"

    cleanup() {
        [ ! -e "$tmp_output" ] || rm -f "$tmp_output"
    }

    trap cleanup EXIT INT TERM HUP

    if ! run_add_audio "$video_encoder" "$input" "$audio_input" "$tmp_output" "$input_is_image"; then
        error "audio addition failed"
        exit 1
    fi

    mv -f -- "$tmp_output" "$output"
    trap - EXIT INT TERM HUP
    printf 'created: %s\n' "$output"
    exit 0
fi

if [ -n "$frame_time" ] && [ -n "$frame_interval" ]; then
    base=$(multi_frame_output_base "$input" "$requested_output")
    outputs=()
    timestamps=()
    tmp_outputs=()
    i=0

    while [ "$i" -lt "$frame_count" ]; do
        ts=$(awk "BEGIN {printf \"%.3f\", $frame_seconds + ($i * $frame_interval_seconds)}")
        label=$(seconds_to_filename_timestamp "$ts" "$frame_filename_hours" "$frame_filename_millis")
        out="${base}-${label}.jpg"
        tmp="${base}-${label}.part.jpg"

        if [ "$force" = false ] && [ -e "$out" ]; then
            error "output file already exists: $out"
            exit 1
        fi

        outputs+=( "$out" )
        timestamps+=( "$ts" )
        tmp_outputs+=( "$tmp" )
        i=$((i + 1))
    done

    info "capturing $frame_count frames starting at $frame_time every $frame_interval with JPEG quality $jpeg_quality"

    cleanup_multi() {
        for f in "${tmp_outputs[@]}"; do
            [ ! -e "$f" ] || rm -f "$f"
        done
    }

    trap cleanup_multi EXIT INT TERM HUP

    i=0
    while [ "$i" -lt "$frame_count" ]; do
        if ! capture_frame "$input" "${timestamps[$i]}" "${tmp_outputs[$i]}"; then
            error "frame capture failed at ${timestamps[$i]} seconds"
            exit 1
        fi

        mv -f -- "${tmp_outputs[$i]}" "${outputs[$i]}"
        printf 'created: %s\n' "${outputs[$i]}"
        i=$((i + 1))
    done

    trap - EXIT INT TERM HUP
    exit 0
fi

if [ -n "$frame_time" ]; then
    output=${requested_output:-$(derive_frame_output_path "$input")}

    if [ "$input" = "$output" ]; then
        error "input and output paths must be different"
        exit 1
    fi

    if [ "$force" = false ] && [ -e "$output" ]; then
        error "output file already exists: $output"
        exit 1
    fi

    case "$output" in
        *.jpg|*.jpeg) ;;
        *)
            error "frame output must use .jpg or .jpeg"
            exit 2
            ;;
    esac

    case "$output" in
        *.jpg)  tmp_output="${output%.jpg}.part.jpg" ;;
        *.jpeg) tmp_output="${output%.jpeg}.part.jpeg" ;;
    esac

    info "capturing frame at $frame_time with JPEG quality $jpeg_quality"

    cleanup() {
        [ ! -e "$tmp_output" ] || rm -f "$tmp_output"
    }

    trap cleanup EXIT INT TERM HUP

    if ! capture_frame "$input" "$frame_seconds" "$tmp_output"; then
        error "frame capture failed"
        exit 1
    fi

    mv -f -- "$tmp_output" "$output"
    trap - EXIT INT TERM HUP
    printf 'created: %s\n' "$output"
    exit 0
fi

output=${requested_output:-$(derive_video_output_path "$input")}

if [ "$input" = "$output" ]; then
    error "input and output paths must be different"
    exit 1
fi

if [ "$force" = false ] && [ -e "$output" ]; then
    error "output file already exists: $output"
    exit 1
fi

if ! have_aac_encoder; then
    error "AAC encoder not found in ffmpeg"
    exit 1
fi

case "$output" in
    *.mp4) tmp_output="${output%.mp4}.part.mp4" ;;
    *)     tmp_output="${output}.part.mp4" ;;
esac

if ! video_encoder=$(select_video_encoder); then
    error "no supported H.264 encoder found in ffmpeg"
    error "tried: libx264, libopenh264, h264_nvenc, h264_qsv, h264_amf, h264_mf, h264_d3d12va, h264_vulkan, h264_videotoolbox"
    exit 1
fi

info "using video encoder: $video_encoder"

if [ -n "$clip_start" ] && [ -n "$clip_end" ]; then
    info "creating clip from $clip_start to $clip_end"
elif [ -n "$clip_start" ]; then
    info "creating clip from $clip_start to end of input"
elif [ -n "$clip_end" ]; then
    info "creating clip from start of input to $clip_end"
fi

cleanup() {
    [ ! -e "$tmp_output" ] || rm -f "$tmp_output"
}

trap cleanup EXIT INT TERM HUP

if ! run_ffmpeg "$video_encoder" "$input" "$tmp_output"; then
    error "conversion failed"
    exit 1
fi

mv -f -- "$tmp_output" "$output"
trap - EXIT INT TERM HUP
printf 'created: %s\n' "$output"