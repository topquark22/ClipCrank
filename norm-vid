#!/usr/bin/env bash
set -eu

progname="${0##*/}"

preserve_metadata=false
clear_metadata=false
metadata_args=()
positional_args=()

fps=
cfr=false
trim_seconds=
clip_start=
clip_end=
clip_duration=

usage() {
    cat <<EOF
Usage: $progname [OPTIONS] INPUT [OUTPUT]

Convert INPUT video into a standardized H.264/AAC MP4 file.

Arguments:
  INPUT                    Path to input video file
  OUTPUT                   Optional output .mp4 path

Options:
  --metadata KEY=VALUE     Set an MP4 metadata field; may be repeated
  --title TEXT             Set title metadata
  --artist TEXT            Set artist metadata
  --album TEXT             Set album metadata
  --date TEXT              Set date metadata
  --comment TEXT           Set comment metadata
  --preserve-metadata      Preserve input global metadata before applying edits
  --clear-metadata         Clear input global metadata before applying edits
  --trim-seconds N         Trim N seconds from the start during conversion
  --start TIME             Clip start time as h:m:s[.ms]; requires --end
  --end TIME               Clip end time as h:m:s[.ms]; requires --start
  --fps N                  Convert output video to frame rate N
  --cfr                    Force constant frame rate output; cannot be used with --fps
  -h, --help               Show this help text

Examples:
  $progname old-video.avi
  $progname input.mov output.mp4
  $progname --title "New Title" input.avi
  $progname --trim-seconds 0.04 input.mp4 output.mp4
  $progname --start 0:01:12.500 --end 0:02:05 input.mov clip.mp4
  $progname --fps 30 input.mov
  $progname --cfr input.mov
EOF
}

error() {
    printf '%s: %s\n' "$progname" "$*" >&2
}

info() {
    printf '%s: %s\n' "$progname" "$*"
}

have_command() {
    command -v "$1" >/dev/null 2>&1
}

derive_output_path() {
    input=$1

    case "$input" in
        *.*) printf '%s\n' "${input%.*}.mp4" ;;
        *)   printf '%s\n' "${input}.mp4" ;;
    esac
}

add_metadata() {
    key=$1
    value=$2

    metadata_args+=( -metadata "$key=$value" )
}

add_metadata_pair() {
    pair=$1

    case "$pair" in
        *=*) metadata_args+=( -metadata "$pair" ) ;;
        *)
            error "metadata must be in KEY=VALUE form: $pair"
            exit 2
            ;;
    esac
}

require_option_value() {
    option=$1
    remaining=$2

    if [ "$remaining" -lt 2 ]; then
        error "$option requires a value"
        exit 2
    fi
}

reject_equals_option() {
    option=$1

    error "use '$option VALUE', not '$option=VALUE'"
    exit 2
}

set_metadata_option() {
    option=$1
    value=$2

    case "$option" in
        --title)   add_metadata title "$value" ;;
        --artist)  add_metadata artist "$value" ;;
        --album)   add_metadata album "$value" ;;
        --date)    add_metadata date "$value" ;;
        --comment) add_metadata comment "$value" ;;
        *)
            error "internal parser error for metadata option: $option"
            exit 2
            ;;
    esac
}

validate_nonnegative_number() {
    value=$1
    name=$2

    case "$value" in
        ''|*[!0-9.]*|*.*.*)
            error "$name must be a non-negative number"
            exit 2
            ;;
    esac

    awk "BEGIN { exit !($value >= 0) }" || {
        error "$name must be greater than or equal to zero"
        exit 2
    }
}

validate_positive_number() {
    value=$1
    name=$2

    case "$value" in
        ''|*[!0-9.]*|*.*.*)
            error "$name must be a positive number"
            exit 2
            ;;
    esac

    awk "BEGIN { exit !($value > 0) }" || {
        error "$name must be greater than zero"
        exit 2
    }
}

validate_timestamp() {
    value=$1
    name=$2

    if [[ ! "$value" =~ ^[0-9]+:([0-5]?[0-9]):([0-5]?[0-9])(\.[0-9]{1,3})?$ ]]; then
        error "$name must be in h:m:s[.ms] form"
        exit 2
    fi
}

timestamp_to_seconds() {
    awk -F: '{ printf "%.3f\n", ($1 * 3600) + ($2 * 60) + $3 }' <<< "$1"
}

validate_clip() {
    if [ -n "$clip_start" ] && [ -z "$clip_end" ]; then
        error "--start requires --end"
        exit 2
    fi

    if [ -z "$clip_start" ] && [ -n "$clip_end" ]; then
        error "--end requires --start"
        exit 2
    fi

    if [ -z "$clip_start" ]; then
        return
    fi

    if [ -n "$trim_seconds" ]; then
        error "--trim-seconds cannot be used with --start and --end"
        exit 2
    fi

    validate_timestamp "$clip_start" "start"
    validate_timestamp "$clip_end" "end"

    start_seconds=$(timestamp_to_seconds "$clip_start")
    end_seconds=$(timestamp_to_seconds "$clip_end")

    awk "BEGIN { exit !($end_seconds > $start_seconds) }" || {
        error "--end must be later than --start"
        exit 2
    }

    clip_duration=$(awk "BEGIN { printf \"%.3f\", $end_seconds - $start_seconds }")
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -h|--help)
                usage
                exit 0
                ;;
            --*=*)
                reject_equals_option "${1%%=*}"
                ;;
            --metadata)
                require_option_value "$1" "$#"
                add_metadata_pair "$2"
                shift 2
                ;;
            --title|--artist|--album|--date|--comment)
                require_option_value "$1" "$#"
                set_metadata_option "$1" "$2"
                shift 2
                ;;
            --preserve-metadata)
                preserve_metadata=true
                shift
                ;;
            --clear-metadata)
                clear_metadata=true
                shift
                ;;
            --trim-seconds)
                require_option_value "$1" "$#"
                trim_seconds=$2
                shift 2
                ;;
            --start)
                require_option_value "$1" "$#"
                clip_start=$2
                shift 2
                ;;
            --end)
                require_option_value "$1" "$#"
                clip_end=$2
                shift 2
                ;;
            --fps)
                require_option_value "$1" "$#"
                fps=$2
                shift 2
                ;;
            --cfr)
                cfr=true
                shift
                ;;
            --)
                shift
                while [ "$#" -gt 0 ]; do
                    positional_args+=( "$1" )
                    shift
                done
                ;;
            --*)
                error "unknown option: $1"
                usage >&2
                exit 2
                ;;
            *)
                positional_args+=( "$1" )
                shift
                ;;
        esac
    done

    if [ "$preserve_metadata" = true ] && [ "$clear_metadata" = true ]; then
        error "--preserve-metadata and --clear-metadata cannot be used together"
        exit 2
    fi

    if [ -n "$fps" ] && [ "$cfr" = true ]; then
        error "--fps and --cfr cannot be used together"
        exit 2
    fi

    if [ -n "$fps" ]; then
        validate_positive_number "$fps" "fps"
    fi

    if [ -n "$trim_seconds" ]; then
        validate_nonnegative_number "$trim_seconds" "trim-seconds"
    fi

    validate_clip
}

have_encoder() {
    encoder=$1
    ffmpeg -hide_banner -encoders 2>/dev/null | awk '{print $2}' | grep -Fx "$encoder" >/dev/null 2>&1
}

select_video_encoder() {
    for encoder in \
        libx264 \
        libopenh264 \
        h264_nvenc \
        h264_qsv \
        h264_amf \
        h264_mf \
        h264_d3d12va \
        h264_vulkan \
        h264_videotoolbox
    do
        if have_encoder "$encoder"; then
            printf '%s\n' "$encoder"
            return 0
        fi
    done

    return 1
}

have_aac_encoder() {
    have_encoder aac
}

video_encoder_args() {
    encoder=$1

    case "$encoder" in
        libx264)
            printf '%s\n' \
                -c:v libx264 \
                -preset medium \
                -crf 23
            ;;
        libopenh264)
            printf '%s\n' \
                -c:v libopenh264 \
                -b:v 5000k
            ;;
        h264_nvenc|h264_qsv|h264_amf|h264_mf|h264_d3d12va|h264_vulkan|h264_videotoolbox)
            printf '%s\n' \
                -c:v "$encoder" \
                -b:v 5000k
            ;;
        *)
            error "unsupported encoder selection: $encoder"
            return 1
            ;;
    esac
}

build_video_filters() {
    filters=( "scale=trunc(iw/2)*2:trunc(ih/2)*2" )

    if [ -n "$fps" ]; then
        filters+=( "fps=$fps" )
    fi

    IFS=,
    printf '%s\n' "${filters[*]}"
}

run_ffmpeg() {
    encoder=$1
    input=$2
    tmp_output=$3

    encoder_args=()
    while IFS= read -r arg; do
        encoder_args+=( "$arg" )
    done <<EOF
$(video_encoder_args "$encoder")
EOF

    metadata_mode_args=()
    if [ "$clear_metadata" = true ]; then
        metadata_mode_args=( -map_metadata -1 )
    elif [ "$preserve_metadata" = true ]; then
        metadata_mode_args=( -map_metadata 0 )
    fi

    cfr_args=()
    if [ "$cfr" = true ]; then
        cfr_args=( -vsync cfr )
    fi

    seek_args=()
    if [ -n "$clip_start" ]; then
        seek_args=( -ss "$clip_start" )
    elif [ -n "$trim_seconds" ]; then
        seek_args=( -ss "$trim_seconds" )
    fi

    duration_args=()
    if [ -n "$clip_duration" ]; then
        duration_args=( -t "$clip_duration" )
    fi

    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -fflags +genpts \
        "${seek_args[@]}" \
        -i "$input" \
        "${duration_args[@]}" \
        -map 0:v:0 \
        -map 0:a? \
        -dn \
        -sn \
        "${cfr_args[@]}" \
        "${metadata_mode_args[@]}" \
        "${metadata_args[@]}" \
        "${encoder_args[@]}" \
        -pix_fmt yuv420p \
        -vf "$(build_video_filters)" \
        -movflags +faststart \
        -c:a aac \
        -b:a 192k \
        -f mp4 \
        "$tmp_output"
}

parse_args "$@"

if [ "${#positional_args[@]}" -lt 1 ] || [ "${#positional_args[@]}" -gt 2 ]; then
    usage >&2
    exit 2
fi

input=${positional_args[0]}
output=${positional_args[1]:-$(derive_output_path "$input")}

if ! have_command ffmpeg; then
    error "ffmpeg is not installed or not on PATH"
    exit 127
fi

if [ ! -e "$input" ]; then
    error "input file not found: $input"
    exit 1
fi

if [ ! -f "$input" ]; then
    error "input path is not a regular file: $input"
    exit 1
fi

if [ ! -r "$input" ]; then
    error "input file is not readable: $input"
    exit 1
fi

if [ "$input" = "$output" ]; then
    error "input and output paths must be different"
    exit 1
fi

if [ -e "$output" ]; then
    error "output file already exists: $output"
    exit 1
fi

if ! have_aac_encoder; then
    error "AAC encoder not found in ffmpeg"
    exit 1
fi

case "$output" in
    *.mp4) tmp_output="${output%.mp4}.part.mp4" ;;
    *)     tmp_output="${output}.part.mp4" ;;
esac

if ! video_encoder=$(select_video_encoder); then
    error "no supported H.264 encoder found in ffmpeg"
    error "tried: libx264, libopenh264, h264_nvenc, h264_qsv, h264_amf, h264_mf, h264_d3d12va, h264_vulkan, h264_videotoolbox"
    exit 1
fi

info "using video encoder: $video_encoder"

if [ -n "$trim_seconds" ]; then
    info "trimming start by $trim_seconds seconds"
fi

if [ -n "$clip_start" ]; then
    info "creating clip from $clip_start to $clip_end"
fi

cleanup() {
    if [ -e "$tmp_output" ]; then
        rm -f "$tmp_output"
    fi
}

trap cleanup EXIT INT TERM HUP

if ! run_ffmpeg "$video_encoder" "$input" "$tmp_output"; then
    error "conversion failed"
    exit 1
fi

mv -- "$tmp_output" "$output"

trap - EXIT INT TERM HUP

printf 'created: %s\n' "$output"
